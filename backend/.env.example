# ===========================================================================
# TaxScraper — environment template
#
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
#   cp backend/.env.example backend/.env
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Tax year ----------------------------------------------------------------
# The year every product opens on when none is chosen. Each product clamps it
# to the years its rules cover. Bump it with the yearly rule update.
DEFAULT_TAX_YEAR=2026


# --- Secrets ---------------------------------------------------------------
# SECURITY: generate unique values per environment. Never reuse across envs.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_url_safe_random_string

# Fernet keys for envelope encryption. Generate each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# FILE_ENCRYPTION_KEY  -> encrypts uploaded originals in the raw zone
# VAULT_ENCRYPTION_KEY -> encrypts the token->original PII mapping vault
# These MUST be different keys. Losing VAULT_ENCRYPTION_KEY makes rehydration
# impossible (by design: the mapping is worthless without it).
FILE_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=


# --- Database --------------------------------------------------------------
# SQLite (local dev, zero setup):
DATABASE_URL=sqlite:///./data/taxscraper.db
# PostgreSQL (production) — swap the URL, no code changes needed:
# DATABASE_URL=postgresql+psycopg://taxuser:password@localhost:5432/taxscraper


# --- Storage zones ---------------------------------------------------------
# Four physically separated zones. See docs/ARCHITECTURE.md.
#   raw    -> encrypted originals, never leaves the host
#   masked -> tokenized artifacts, the ONLY zone the LLM may read from
#   output -> rehydrated deliverables
#   tmp    -> scratch, purged on a schedule
DATA_DIR=./data
RAW_ZONE_DIR=./data/raw
MASKED_ZONE_DIR=./data/masked
OUTPUT_ZONE_DIR=./data/output
TMP_ZONE_DIR=./data/tmp
VECTOR_STORE_DIR=./data/vector


# --- Sample workpaper corpus (input -> output template learning) -----------
# Folder holding workpapers and their "*copy*" outputs. Relative paths are
# anchored to the repo root; absolute paths use forward slashes.
TAX_FILES_DIR=./Files
# Filename substring (case-insensitive) that marks a file as an EXPECTED OUTPUT.
TAX_FILES_OUTPUT_MARKER=copy


# --- Gemini ----------------------------------------------------------------
# SECURITY: the key is read from the environment only. Never hardcode it,
# never log it, never return it from an API endpoint.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model routing. Override per tier without touching code.
GEMINI_MODEL_FLASH=gemini-3.6-flash               # default production workhorse
GEMINI_MODEL_PRO=gemini-3.1-pro-preview           # escalation / complex reasoning
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite     # high-volume batch extraction

GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
# Rate limiting (HTTP 429) is handled separately: a quota window is a minute
# wide, so a call that is throttled gets a larger attempt budget and waits for
# the window to reset rather than sprinting back into it.
GEMINI_RATE_LIMIT_MAX_RETRIES=6
GEMINI_RATE_LIMIT_MAX_WAIT_SECONDS=180
# Minimum gap between outbound calls. 0 = no pacing until a 429 is seen, after
# which pacing engages on its own. Raise it for a low-RPM free-tier key.
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=0
GEMINI_TEMPERATURE=0.1                            # low: tax work is not creative
# Master kill switch. false => every LLM call returns a deterministic stub.
# The app remains fully functional offline for demos and CI.
GEMINI_ENABLED=true


# --- LLM egress guard ------------------------------------------------------
# SECURITY: last line of defence. Scans every outbound LLM payload for
# unmasked PII patterns and refuses to send if any are found.
LLM_EGRESS_GUARD_ENABLED=true
# block => raise and abort the call (recommended)
# warn  => log an audit event and send anyway (NOT for production)
LLM_EGRESS_GUARD_MODE=block


# --- OCR -------------------------------------------------------------------
# Path to tesseract.exe. Leave blank to auto-detect: ./Tesseract-OCR beside the
# repo, then Program Files, then LOCALAPPDATA (where unelevated winget installs).
# Relative paths are anchored to the repo root.
TESSERACT_CMD=
OCR_DPI=300
OCR_LANGUAGE=eng
# Minimum mean OCR word confidence (0-100) before a page is flagged for review.
OCR_MIN_CONFIDENCE=60

# SECURITY: when true, scanned pages that local OCR cannot read may be sent to
# a multimodal cloud model AS IMAGES. Raw images cannot be pre-masked, so this
# is a deliberate privacy downgrade. Off by default; every use is audit-logged.
ALLOW_CLOUD_OCR_FALLBACK=false


# --- Upload validation -----------------------------------------------------
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.tif,.bmp,.docx,.xlsx,.xls,.csv,.txt


# --- Tax & audit assistant -----------------------------------------------
# Every answer is one streamed call with Google Search grounding, checked when
# it finishes. This is the only place the assistant's answering model is named.
ASSISTANT_MODEL=gemini-3.8-flash
# Thinking level for the answer call (low | high); empty = the model default.
ASSISTANT_THINKING_LEVEL=low
# Small model that classifies each question first (answer type, scope, whether
# it depends on state law). Empty = no routing: general policy, and the
# selected state always applies.
ASSISTANT_ROUTER_MODEL=gemini-3.5-flash-lite
ASSISTANT_ROUTER_THINKING_LEVEL=minimal
# Replay a checked answer to the same general question asked again the same
# day (in memory, per process; never /mask, follow-ups or attachments).
# 0 entries or 0 seconds turns it off.
ASSISTANT_CACHE_MAX_ENTRIES=500
ASSISTANT_CACHE_TTL_SECONDS=21600
# Predicts an imported asset's life (MACRS class) from its description. It
# never computes an amount - the depreciation engine does the arithmetic.
DEPRECIATION_LIFE_MODEL=gemini-3.8-flash
DEPRECIATION_LIFE_THINKING_LEVEL=low
# Low: the same question should get the same facts.
ASSISTANT_TEMPERATURE=0.2
# Prior question/answer pairs replayed for follow-ups.
ASSISTANT_HISTORY_TURNS=4
# Grounding returns short-lived Google redirect links. When true, one redirect
# hop is read (headers only) so stored citations keep working and show the
# real domain. Only the Google redirect host is ever contacted for this.
ASSISTANT_RESOLVE_SOURCE_URLS=true
ASSISTANT_RESOLVE_TIMEOUT_SECONDS=3.0
# Ceiling on attached-document text (masked) included in one prompt.
ASSISTANT_MAX_ATTACHMENT_CHARS=12000


# --- Outbound fetching (state updates panel) -------------------------------
OUTBOUND_USER_AGENT=TaxScraperResearchBot/1.0
OUTBOUND_FETCH_DELAY_SECONDS=1.0
OUTBOUND_CACHE_TTL_SECONDS=900
OUTBOUND_CACHE_MAX_ENTRIES=128


# --- Outbound TLS ----------------------------------------------------------
# SECURITY: verification stays ON. On a TLS-inspecting corporate network the
# bundled CA list rejects the proxy's re-signed certs. Verifying against the OS
# trust store (which already trusts that proxy root) fixes fetches to irs.gov
# and other sources without weakening security. Set a PEM path to override.
USE_OS_TRUSTSTORE=true
CA_BUNDLE_PATH=


# --- Confidence thresholds (drive human-in-the-loop routing) ---------------
# Below AUTO_APPROVE  -> always queued for review
# Below ESCALATE      -> routed to the Pro model before review
CONFIDENCE_AUTO_APPROVE=0.90
CONFIDENCE_ESCALATE=0.75
# Absolute dollar tolerance for deterministic recomputation vs LLM extraction.
CALC_TOLERANCE_DOLLARS=1.00


# --- Retention -------------------------------------------------------------
RETENTION_RAW_DAYS=2555              # 7 years — IRS record retention
RETENTION_MASKED_DAYS=365
RETENTION_TMP_DAYS=7
RETENTION_AUDIT_DAYS=2555


# --- Rate limiting ---------------------------------------------------------
# How FAST. In-process, fixed one-minute window, resets when the process does.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30


# --- Daily quotas ----------------------------------------------------------
# How MUCH per day. Stored in the database, so unlike the burst limits above
# these survive the restarts a sleeping free-tier service does several times a
# day. Counted against the document-run and chat endpoints, which are the two
# that spend OCR CPU and model tokens. 0 or below means unlimited.
#
# The *_GLOBAL values bound the whole deployment and are what actually caps a
# shared API key's bill: a per-client cap times an unknown number of testers is
# not a cap. Both ceilings apply and the lower one wins.
DAILY_QUOTA_ENABLED=true
DAILY_QUOTA_UPLOAD_PER_CLIENT=5
DAILY_QUOTA_UPLOAD_GLOBAL=40
DAILY_QUOTA_CHAT_PER_CLIENT=25
DAILY_QUOTA_CHAT_GLOBAL=200
DAILY_QUOTA_DEFAULT_PER_CLIENT=200
DAILY_QUOTA_DEFAULT_GLOBAL=2000


# --- Auth / RBAC -----------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Dev convenience: skip auth and act as DEV_DEFAULT_ROLE.
# SECURITY: config.py refuses to start if this is true while APP_ENV=production.
AUTH_DISABLED=true
DEV_DEFAULT_ROLE=admin               # admin | reviewer | preparer | readonly
# The name the dashboard greets the development login by.
DEV_DISPLAY_NAME=Varun

# Accounts created (or reconciled) on every start, as username:role:password
# separated by commas. Passwords need 12+ characters.
#
# The environment is the source of truth: change a password here and restart,
# and that account is reset to it. There is no admin UI and no reset flow, on
# purpose — both would be more surface than a test deployment needs.
#
# SECURITY: this holds live passwords. Set it in the host's secret store, never
# in a committed file. Leave it empty in development, where AUTH_DISABLED
# already grants every caller DEV_DEFAULT_ROLE.
#   BOOTSTRAP_USERS=alice:preparer:correct-horse-battery,bob:admin:another-long-one
BOOTSTRAP_USERS=

# --- Industry Updates feed (dashboard / Industry Updates) -------------------
# Public IRS and Treasury pages, fetched in the background and cached.
NEWS_ENABLED=true
NEWS_REFRESH_SECONDS=1800
NEWS_MIN_FETCH_INTERVAL_SECONDS=300
# Licensed sources: never scraped. Leave empty unless you hold an API licence;
# the source shows "Connect your ... account to enable" until both are set.
BLOOMBERG_TAX_API_URL=
BLOOMBERG_TAX_API_KEY=
THOMSON_REUTERS_API_URL=
THOMSON_REUTERS_API_KEY=
